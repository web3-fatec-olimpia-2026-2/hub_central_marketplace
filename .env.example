# Os códigos foram gerados com auxilio de I.A.
# Configurações do Django
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True

# Injeção de credenciais e modo de desenvolvimento
LOGIN_DEBUG=True
LOGIN_DEBUG_USERNAME=devmaster
LOGIN_DEBUG_PASSWORD=

# ----------------------------------------------------------------------
# MERCADO LIVRE - OAUTH 2.0 (INFRAESTRUTURA CENTRAL)
# ----------------------------------------------------------------------
MERCADOLIVRE_CORE_CLIENT_ID=
MERCADOLIVRE_CORE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# Chave mestra de criptografia para tokens em repouso no banco (Fernet - 32 bytes URL-safe base64)
FIELD_ENCRYPTION_KEY=

# Feature Flag de Simulação Mock (OAuth e APIs de Marketplaces)
SIMULAR_ROTAS_MOCK=True

# ==============================================================================
# AVISO DE SEGURANÇA PARA AMBIENTES DE PRODUÇÃO:
# 1. As flags DEBUG e LOGIN_DEBUG DEVEM ser configuradas estritamente como False em produção.
# 2. O aplicativo 'apps.mockar_dados' é de uso exclusivo para testes e desenvolvimento.
#    Em qualquer deploy real em ambiente de produção, este app deve ser removido de
#    INSTALLED_APPS no settings.py (ou ter seu diretório 'apps/mockar_dados' excluído fisicamente).
# ==============================================================================
